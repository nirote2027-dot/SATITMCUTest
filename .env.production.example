# =================================================================
# Production Environment Variables for SATIT MCU System (Docker)
# คัดลอกไฟล์นี้เป็น .env.production หรือกำหนดค่าใน docker-compose.yml
# =================================================================

# 1. ฐานข้อมูล PostgreSQL สำหรับ Docker
DB_PASSWORD=postgres_secure_pass_change_this
DATABASE_URL=postgresql://postgres:postgres_secure_pass_change_this@db:5432/ums_prod

# 2. คีย์ความปลอดภัยสำหรับ Session (สุ่ม 32 bytes ด้วย: openssl rand -base64 32)
AUTH_SECRET=changeme-generate-a-strong-32-byte-base64-secret-key

# 3. URL ของระบบที่ผู้ใช้เข้าใช้งาน
APP_URL=http://localhost:3010
NEXTAUTH_URL=http://localhost:3010

# 4. การตั้งค่าส่งอีเมล (SMTP) (ไม่บังคับ - ถ้าเว้นว่างระบบจะบันทึกใน Server Log แทน)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SATIT MCU System <no-reply@satitmcu.ac.th>"

# 5. OAuth Login (ไม่บังคับ - ถ้าเว้นว่างปุ่มจะไม่แสดง)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# 6. บัญชี Admin เริ่มต้นสำหรับระบบใหม่
BOOTSTRAP_ADMIN_EMAIL=admin@satitmcu.ac.th
BOOTSTRAP_ADMIN_PASSWORD=Passw0rd!SecureAdmin2026
